APP_NAME=Renderdex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://renderdex.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=renderdex
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Steam Web API: https://steamcommunity.com/dev/apikey
# Solo en .env, nunca en el frontend, los logs ni el repositorio.
STEAM_API_KEY=
STEAM_REDIRECT_URI="${APP_URL}/auth/steam/callback"

# PCGamingWiki: bot password creado en Special:BotPasswords con el permiso de Cargo.
# Formato del usuario: TuUsuario@NombreDelBot
PCGW_BOT_USERNAME=
PCGW_BOT_PASSWORD=
